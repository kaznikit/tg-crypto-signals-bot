# --- Telegram (пользовательский аккаунт, не бот) ---
# Получить на https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
# Канал с сигналами: username без @ (например "signals_channel") или числовой ID (-100...).
# НЕ отображаемое название канала! Если не знаете username/ID - запустите
# `python -m bot.list_chats` после заполнения TG_API_ID/TG_API_HASH выше.
TG_SOURCE_CHAT=signals_channel
# Имя файла сессии Telethon (создастся автоматически при первом запуске)
TG_SESSION_NAME=session/user

# --- Уведомления о сделках (отдельный TG-канал/чат через Bot API) ---
# Токен бота-нотификатора, выданный @BotFather
NOTIFY_BOT_TOKEN=your_notify_bot_token_here
# ID или @username канала/чата, куда бот будет писать о сделках.
# Бот должен быть добавлен в канал как администратор с правом публикации сообщений.
# Как узнать chat_id: добавьте бота в канал, отправьте туда любое сообщение,
# затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates и найдите "chat":{"id": ...}
NOTIFY_CHAT_ID=

# --- Bybit ---
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
# true = тестовая сеть Bybit (testnet.bybit.com), false = mainnet
BYBIT_TESTNET=false
# true = Demo Trading на mainnet (реальные котировки, виртуальный баланс,
# отдельные API-ключи из раздела Demo Trading). Нельзя включать вместе с BYBIT_TESTNET.
BYBIT_DEMO=false

# --- Параметры торговли ---
# Фиксированный размер сделки в USDT (маржа, без учёта плеча)
ORDER_SIZE_USDT=50
# Плечо, выставляется на инструмент перед входом
LEVERAGE=5
# Соотношение тейка к стопу (1:2 по умолчанию)
RISK_REWARD=2.0
# Таймфрейм для поиска экстремума под стоп: 5 или 15 (минуты)
STOP_TIMEFRAME=5
# Доп. отступ от экстремума в процентах от цены (защита от "прокола" стопа)
STOP_OFFSET_PCT=0.05
# Сколько свечей слева/справа должно быть ниже/выше, чтобы считать точку свинг-экстремумом
SWING_WINDOW=2
# Сколько последних свечей просматривать в поиске экстремума
STOP_LOOKBACK_CANDLES=200
# Не открывать сделку, если сигнал старше этого числа секунд
MAX_SIGNAL_AGE_SECONDS=120

# Если true - сделки не отправляются на биржу, только считаются и логируются
DRY_RUN=false

# Уровень логирования
LOG_LEVEL=INFO
